---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FeatureCard from '../components/FeatureCard.astro';
import {SITE_DESCRIPTION, SITE_TITLE} from '../consts';

const age = (new Date()).getFullYear() - 2002;
// 欢迎页面特性数据
const welcomeFeatures = [
  {
    icon: "⌛️",
    title: `已年近${age <= 25 ? '百中一刻' : age <= 50 ? '半百，还没熬出头' : '快入坟了，还没退休'}`,
    description: `现在的我已经${age}岁了！`,
    delay: 0
  },
  {
    icon: "🤔",
    title: "多少钱算够",
    description: "算了，一边挣一边花吧",
    delay: 100
  },
  {
    icon: "🚗",
    title: "要买什么车呢",
    description: "还要自己作自己的车夫吗，还是公交车🚌和地铁🚇来的更舒服吧，我只需要站着或坐着，其他都不用我想了😋",
    delay: 200
  },
  {
    icon: "👧",
    title: "以后不会光棍了吧",
    description: "吓哭了😭",
    delay: 300
  }
];
---

<!doctype html>
<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
  <style>
    .welcome-container {
      max-width: 1400px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    /* 英雄区域 */
    .hero-section {
      text-align: center;
      margin-bottom: 100px;
      position: relative;
    }

    /* 打字机效果标题 */
    .hero-title {
      font-size: 4.5rem;
      font-weight: 800;
      margin-bottom: 30px;
      background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 50%, #f472b6 100%);
      background-size: 200% auto;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: gradientShift 3s ease infinite, fadeInUp 1s ease;
      text-shadow: 0 0 60px rgba(96, 165, 250, 0.5);
      letter-spacing: -2px;
      position: relative;
      display: inline-block;
    }

    @keyframes gradientShift {
      0%, 100% {
        background-position: 0% center;
      }
      50% {
        background-position: 100% center;
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* 打字光标效果 */
    .hero-title::after {
      content: '|';
      position: absolute;
      right: -10px;
      animation: blink 1s step-end infinite;
      color: #60a5fa;
    }

    @keyframes blink {
      0%, 100% {
        opacity: 1;
      }
      50% {
        opacity: 0;
      }
    }

    /* 副标题 */
    .hero-subtitle {
      font-size: 1.5rem;
      color: #94a3b8;
      margin-bottom: 20px;
      animation: fadeInUp 1s ease 0.3s backwards;
    }

    /* 打字效果的副标题 */
    .typewriter {
      display: inline-block;
      overflow: hidden;
      white-space: nowrap;
      border-right: 3px solid #60a5fa;
      animation: typing 1s steps(18, end),
      blink-caret 0.75s step-end infinite;
    }

    @keyframes typing {
      from {
        width: 0
      }
      to {
        width: 196px
      }
    }

    @keyframes blink-caret {
      from, to {
        border-color: transparent
      }
      50% {
        border-color: #60a5fa
      }
    }

    /* CTA 按钮 */
    .cta-button {
      display: inline-block;
      padding: 18px 48px;
      font-size: 1.1rem;
      font-weight: 600;
      color: white;
      background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
      border: none;
      border-radius: 50px;
      cursor: pointer;
      text-decoration: none;
      position: relative;
      overflow: hidden;
      transition: all 0.4s ease;
      animation: fadeInUp 1s ease 0.6s backwards;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4),
      0 0 30px rgba(139, 92, 246, 0.2);
    }

    .cta-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.6s;
    }

    .cta-button:hover::before {
      left: 100%;
    }

    .cta-button:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 8px 25px rgba(59, 130, 246, 0.6),
      0 0 50px rgba(139, 92, 246, 0.4);
    }

    /* 特性卡片网格 */
    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      margin-top: 80px;
    }

    /* 响应式设计 */
    @media (max-width: 1024px) {
      .hero-title {
        font-size: 3.5rem;
      }

      .hero-subtitle {
        font-size: 1.2rem;
      }

      .features-grid {
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 25px;
      }
    }

    @media (max-width: 640px) {
      .welcome-container {
        padding: 100px 15px 40px 15px;
      }

      .hero-title {
        font-size: 2.5rem;
      }

      .hero-subtitle {
        font-size: 1rem;
      }

      .cta-button {
        padding: 15px 36px;
        font-size: 1rem;
      }

      .features-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
<Header/>

<div class="welcome-container">
  <!-- 英雄区域 -->
  <section class="hero-section">
    <h1 class="hero-title">SkySource's Blog</h1>
    <p class="hero-subtitle">
      <span class="typewriter">some tools is here</span>
    </p>
    <a href="/console-log" class="cta-button">开始探索 →</a>
  </section>

  <!-- 特性卡片 -->
  <div class="features-grid">
    {welcomeFeatures.map((feature) => (
            <FeatureCard
                    icon={feature.icon}
                    title={feature.title}
                    description={feature.description}
                    delay={feature.delay}
                    :key={feature.title}
            />
    ))}
  </div>
</div>

<Footer/>
</body>
</html>
