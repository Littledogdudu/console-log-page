---
import MarkdownCard from "../components/MarkdownCard.astro";
import GifCard from "../components/GifCard.astro";
import {SITE_DESCRIPTION, SITE_TITLE} from "../consts.ts";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { pluginFeatures } from "./config/data.js";

---

<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
  <style>
    .container {
      max-width: 1400px;
      margin: 20px auto;
      position: relative;
      z-index: 1;
    }

    .page-title {
      text-align: center;
      font-size: 3.5rem;
      height: 4.5rem;
      font-weight: 700;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: 0 0 40px rgba(96, 165, 250, 0.3);
      letter-spacing: -1px;
    }

    .page-subtitle {
      text-align: center;
      font-size: 1.25rem;
      color: #94a3b8;
      margin-bottom: 10px;
      font-weight: 400;
    }

    /* 功能卡片行 */
    .feature-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      margin-bottom: 80px;
      align-items: center;
      position: relative;
    }

    /* 交替布局 */
    .feature-row.reverse {
      direction: rtl;
    }

    .feature-row.reverse > * {
      direction: ltr;
    }

    .download-section {
      position: relative;
      padding: 50px 0;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
    }

    .download-button {
      position: relative;
      padding: 16px 48px;
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      border-radius: 50px;
      cursor: pointer;
      overflow: hidden;
      transition: all 0.3s ease;
      box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .download-button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
    }

    .download-button:hover::before {
      left: 100%;
    }

    .download-button:active {
      transform: translateY(0);
      box-shadow: 0 2px 10px rgba(102, 126, 234, 0.4);
    }

    /* 响应式设计 */
    @media (max-width: 1024px) {
      .feature-row,
      .feature-row.reverse {
        grid-template-columns: 1fr;
        gap: 40px;
        direction: ltr;
      }

      .page-title {
        font-size: 2.5rem;
      }
    }

    @media (max-width: 768px) {
      .download-section {
        position: relative;
        bottom: auto;
        left: auto;
        transform: none;
        margin: 60px 0;
      }

      .download-button {
        padding: 14px 36px;
        font-size: 14px;
      }
    }

    @media (max-width: 640px) {
      .container {
        padding: 60px 15px;
      }

      .page-title {
        height: 2.5rem;
        font-size: 2rem;
      }

      .page-subtitle {
        font-size: 1rem;
        margin-bottom: 60px;
      }

      .feature-row {
        gap: 30px;
        margin-bottom: 60px;
      }
    }
  </style>
</head>
<body>
<Header/>
<div class="container">
  <h1 class="page-title">Console Log Plugin</h1>
  <p class="page-subtitle">
    适用于IDEA、Webstorm的打印console.log表达式插件（GIF图片点击放大预览）
  </p>
  <div class="download-section">
    <a href="https://github.com/Littledogdudu/ConsoleLog/releases" class="download-button" target="_blank" rel="noopener noreferrer"
       download>获取插件</a>
  </div>

  {pluginFeatures.map((feature, index) => (
          <div class={`feature-row ${index % 2 === 1 ? 'reverse' : ''}`} key={feature.id}>
            <!-- GIF 卡片 -->
            <GifCard gifUrl={feature.gifUrl} title={feature.title} id={feature.id} />

            <!-- Markdown 说明卡片 -->
            <MarkdownCard content={feature.description} reverse={index % 2 === 1}/>
          </div>
  ))}
</div>
<Footer/>
</body>
</html>