---
import {SITE_DESCRIPTION, SITE_TITLE} from "../consts.ts";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import HikariTairitsu from "../assets/Hikari-Tairitsu.jpg";
import LUCKY_STAR from "../assets/圣诞泉此方.png";
import Bocchi_the_Rock from "../assets/孤独摇滚.jpg";
import TairitsuSaclia from "../assets/Tairitsu_Saclia.jpg";
import AI_LA from "../assets/艾拉.jpg";
import BA from "../assets/砂狼白子.jpg";
import MOE_YU from "../assets/moeyu.png";
import GET_PLACE from "../assets/让一让腾个地方要饭了.png";
import Dog from "../assets/littledogdudu.jpg";
---

<html lang="zh-CN">
<head>
  <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION}/>
  <style>
    .gallery-container {
      position: relative;
      width: 100%;
      max-width: 1400px;
      min-height: 100vh;
      margin: 0 auto;
      padding: 60px 40px;
      overflow: hidden;
      background: transparent;
      box-sizing: border-box;
    }

    .photo-wrapper {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .photo {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      cursor: pointer;
      border: 8px solid white;
      object-fit: cover;
      display: block;
    }

    .artist-label {
      margin-top: 6px;
      font-size: 11px;
      color: #555;
      font-style: italic;
      text-align: center;
      opacity: 0.8;
      text-shadow: 0 1px 1px rgba(255, 255, 255, 0.9);
      max-width: 100%;
    }

    .artist-label:empty {
      display: none;
    }

    .photo-wrapper:hover .photo {
      transform: scale(1.08) rotate(0deg) !important;
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
      z-index: 1000 !important;
    }

    .wrapper-1 {
      top: 5%;
      left: 15%;
      z-index: 3;
    }
    .wrapper-1 .photo {
      width: 250px;
      height: 310px;
      transform: rotate(-15deg);
    }

    .wrapper-2 {
      top: 3%;
      left: 65%;
      z-index: 5;
    }
    .wrapper-2 .photo {
      width: 270px;
      height: 240px;
      transform: rotate(12deg);
    }

    .wrapper-3 {
      top: 30%;
      left: 20%;
      z-index: 2;
    }
    .wrapper-3 .photo {
      width: 260px;
      height: 280px;
      transform: rotate(-7deg);
    }

    .wrapper-4 {
      top: 25%;
      left: 58%;
      z-index: 4;
    }
    .wrapper-4 .photo {
      width: 290px;
      height: 250px;
      transform: rotate(18deg);
    }

    .wrapper-5 {
      top: 52%;
      left: 25%;
      z-index: 6;
    }
    .wrapper-5 .photo {
      width: 255px;
      height: 300px;
      transform: rotate(-5deg);
    }

    .wrapper-6 {
      top: 48%;
      left: 62%;
      z-index: 7;
    }
    .wrapper-6 .photo {
      width: 275px;
      height: 255px;
      transform: rotate(8deg);
    }

    .wrapper-7 {
      top: 72%;
      left: 8%;
      z-index: 8;
    }
    .wrapper-7 .photo {
      width: 265px;
      height: 265px;
      transform: rotate(-10deg);
    }

    .wrapper-8 {
      top: 18%;
      left: 38%;
      z-index: 1;
    }
    .wrapper-8 .photo {
      width: 240px;
      height: 270px;
      transform: rotate(22deg);
    }

    .wrapper-9 {
      top: 40%;
      left: 45%;
      z-index: 9;
    }
    .wrapper-9 .photo {
      width: 280px;
      height: 240px;
      transform: rotate(-13deg);
    }

    @media (max-width: 768px) {
      .photo-wrapper {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        right: auto !important;
        margin: 20px auto;
      }

      .photo-wrapper .photo {
        transform: none !important;
      }
    }
  </style>
</head>
<body>
<Header/>

<div class="gallery-container">
  <div class="photo-wrapper wrapper-1">
    <img class="photo" src={HikariTairitsu.src} alt="" />
    <span class="artist-label">pivix: 物黍</span>
  </div>

  <div class="photo-wrapper wrapper-2">
    <img class="photo" src={LUCKY_STAR.src} alt="" />
    <span class="artist-label"></span>
  </div>

  <div class="photo-wrapper wrapper-3">
    <img class="photo" src={Bocchi_the_Rock.src} alt="" />
    <span class="artist-label"></span>
  </div>

  <div class="photo-wrapper wrapper-4">
    <img class="photo" src={BA.src} alt="" />
    <span class="artist-label"></span>
  </div>

  <div class="photo-wrapper wrapper-5">
    <img class="photo" src={AI_LA.src} alt="" />
    <span class="artist-label">pivix: 相良 青</span>
  </div>

  <div class="photo-wrapper wrapper-6">
    <img class="photo" src={TairitsuSaclia.src} alt="" />
    <span class="artist-label">pivix: Saclia</span>
  </div>

  <div class="photo-wrapper wrapper-7">
    <img class="photo" src={MOE_YU.src} alt="" />
    <span class="artist-label">pivix: Loading...</span>
  </div>

  <div class="photo-wrapper wrapper-8">
    <img class="photo" src={GET_PLACE.src} alt="" />
    <span class="artist-label"></span>
  </div>

  <div class="photo-wrapper wrapper-9">
    <img class="photo" src={Dog.src} alt="" />
    <span class="artist-label">You are being in my heart</span>
  </div>
</div>

</body>
</html>
