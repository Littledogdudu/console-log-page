---
interface Props {
	gifUrl?: string;
	title: string;
}

const { gifUrl, title } = Astro.props;
---

<div id={`gif-card-${title}`} class="gif-card">
	{gifUrl ? (
		<img src={gifUrl} alt={title} />
	) : (
		<div class="gif-placeholder">
			{title} GIF 演示
		</div>
	)}
</div>

<dialog id={`gif-modal-${title}`} class="gif-modal">
	<div class="modal-content">
		<button class="close-button" aria-label="关闭图片">✕</button>
		{gifUrl && <img src={gifUrl} alt={`${title} 放大查看`} class="modal-image" />}
	</div>
</dialog>

<style>
	.gif-card {
		background: rgba(30, 41, 59, 0.4);
		backdrop-filter: blur(20px);
		border-radius: 20px;
		padding: 20px;
		border: 1px solid rgba(96, 165, 250, 0.2);
		box-shadow:
			0 8px 32px rgba(0, 0, 0, 0.3),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
		position: relative;
		overflow: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.gif-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(96, 165, 250, 0.1), transparent);
		transition: left 0.6s;
	}

	.gif-card:hover::before {
		left: 100%;
	}

	.gif-card:hover {
		border-color: rgba(96, 165, 250, 0.4);
		box-shadow:
			0 12px 48px rgba(96, 165, 250, 0.15),
			inset 0 1px 0 rgba(255, 255, 255, 0.15);
		transform: translateY(-4px);
	}

	.gif-card img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		display: block;
		border: 1px solid rgba(96, 165, 250, 0.1);
	}

	.gif-placeholder {
		width: 100%;
		aspect-ratio: 16/9;
		background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #60a5fa;
		font-size: 1rem;
		border: 2px dashed rgba(96, 165, 250, 0.3);
	}

	/* 模态框样式 */
	.gif-modal {
		margin: auto;
		padding: 0;
		max-width: 90vw;
		max-height: 90vh;
		border: none;
		border-radius: 20px;
		background: transparent;
		overflow: visible;
	}

	.gif-modal::backdrop {
		background: rgba(10, 14, 39, 0.85);
		backdrop-filter: blur(10px);
	}

	.modal-content {
		position: relative;
		background: rgba(30, 41, 59, 0.6);
		backdrop-filter: blur(20px);
		border-radius: 20px;
		padding: 40px;
		border: 1px solid rgba(96, 165, 250, 0.3);
		box-shadow:
			0 20px 60px rgba(0, 0, 0, 0.5),
			inset 0 1px 0 rgba(255, 255, 255, 0.1);
		animation: modalFadeIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@keyframes modalFadeIn {
		from {
			opacity: 0;
			transform: scale(0.95) translateY(-20px);
		}
		to {
			opacity: 1;
			transform: scale(1) translateY(0);
		}
	}

	.modal-image {
		max-width: 100%;
		max-height: 80vh;
		width: auto;
		height: auto;
		display: block;
		border-radius: 12px;
		border: 1px solid rgba(96, 165, 250, 0.2);
	}

	.close-button {
		position: absolute;
		top: 15px;
		right: 15px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 1px solid rgba(96, 165, 250, 0.3);
		background: rgba(30, 41, 59, 0.8);
		color: #60a5fa;
		font-size: 24px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		z-index: 10;
	}

	.close-button:hover {
		background: rgba(96, 165, 250, 0.2);
		border-color: rgba(96, 165, 250, 0.5);
		transform: rotate(90deg) scale(1.1);
		box-shadow: 0 0 20px rgba(96, 165, 250, 0.3);
	}

	/* 响应式设计 */
	@media (max-width: 768px) {
		.gif-modal {
			max-width: 95vw;
			max-height: 95vh;
		}

		.modal-content {
			padding: 30px 20px;
		}

		.modal-image {
			max-height: 70vh;
		}

		.close-button {
			top: 10px;
			right: 10px;
			width: 36px;
			height: 36px;
			font-size: 20px;
		}
	}
</style>

<script define:vars={{ gifUrl, title }}>
	const modal = document.getElementById(`gif-modal-${title}`);
	const triggerImg = document.querySelector(`#gif-card-${title} img`);
	const closeBtn = modal?.querySelector('.close-button');

	// 点击图片打开modal
	triggerImg?.addEventListener('click', () => {
		modal?.showModal();
	});

	// 点击背景关闭
	modal?.addEventListener('click', (e) => {
		const rect = modal.getBoundingClientRect();
		const isInDialog = (
			rect.top <= e.clientY &&
			e.clientY <= rect.top + rect.height &&
			rect.left <= e.clientX &&
			e.clientX <= rect.left + rect.width
		);

		if (!isInDialog) {
			modal.close();
		}
	});

	// 点击关闭按钮
	closeBtn?.addEventListener('click', () => {
		modal?.close();
	});

	// ESC键自动支持，无需代码
</script>
