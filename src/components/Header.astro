---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<!-- SVG Gradient Definition -->
	<svg width="0" height="0" style="position: absolute;">
		<defs>
			<linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
				<stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
				<stop offset="100%" style="stop-color:#a78bfa;stop-opacity:1" />
			</linearGradient>
		</defs>
	</svg>

	<nav>
		<h2 class="site-title"><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-links-container">
			<div class="nav-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/console-log">Console Log</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
		</div>
		<div class="social-links">
			<a href="https://github.com/Littledogdudu/console-log-page" target="_blank">
				<span class="sr-only">Go to Little Dog dudu's GitHub repo</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="url(#gradient)"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		width: 100%;
		margin: 0;
		padding: 0.8em 1em;
    backdrop-filter: blur(10px);
    background: rgba(30, 41, 59, 0.7) radial-gradient(circle, rgba(96, 165, 250, 0.15) 1px, transparent 1px);
    background-size: 15px 15px;
		border-bottom: 1px solid rgba(96, 165, 250, 0.2);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}

	.nav-links-container {
		display: flex;
		align-items: center;
		flex: 1;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		background: linear-gradient(135deg, #60a5fa 0%, #a78bfa 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		transition: all 0.3s ease;
	}

	h2 a:hover {
		filter: drop-shadow(0 0 8px rgba(96, 165, 250, 0.5));
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a {
		padding: 1em 0.5em;
		color: #e2e8f0;
		border-bottom: 2px solid transparent;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	nav a:hover {
		color: #60a5fa;
		border-bottom-color: rgba(96, 165, 250, 0.5);
	}

	nav a.active {
		color: #60a5fa;
		border-bottom-color: #60a5fa;
	}

	.social-links,
	.social-links a {
    margin-right: 30px;
		display: flex;
		align-items: center;
	}

	.social-links a {
		transition: all 0.3s ease;
	}

	.social-links svg {
		transition: all 0.3s ease;
	}

	.social-links a:hover svg {
		filter: drop-shadow(0 0 8px rgba(96, 165, 250, 0.5));
		transform: scale(1.1);
	}

	@media (max-width: 720px) {
		/* 隐藏网站标题 */
		.site-title {
			display: none;
		}

		/* 调整 nav 布局为左对齐 */
		nav {
			justify-content: flex-start;
		}

		/* 启用水平滚动容器 */
		.nav-links-container {
			overflow-x: auto;
			overflow-y: hidden;
			scroll-behavior: smooth;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none; /* Firefox */
			flex: 1;
			max-width: 100%;
			position: relative;
		}

		.nav-links-container::-webkit-scrollbar {
			display: none; /* Chrome, Safari, Edge */
		}

		/* 导航链接不收缩 */
		.nav-links {
			flex-shrink: 0;
			gap: 0.25rem;
			padding: 0 1rem 0 0;
		}

		/* 调整导航链接样式 */
		nav a {
			padding: 0.75em 0.5em;
			font-size: 0.95em;
			white-space: nowrap; /* 防止文字换行 */
		}

		/* 右侧渐变遮罩提示可滑动 */
		.nav-links-container::after {
			content: '';
			position: absolute;
			top: 0;
			right: 0;
			bottom: 0;
			width: 40px;
			background: linear-gradient(
				to right,
				transparent,
				rgba(30, 41, 59, 0.9)
			);
			pointer-events: none;
			z-index: 1;
		}

		/* 社交链接保持隐藏 */
		.social-links {
			display: none;
		}

		header {
			padding: 0.6em 1em;
		}
	}

	/* 桌面端显式样式 (> 720px) */
	@media (min-width: 721px) {
		.nav-links-container {
			justify-content: flex-end; /* 右对齐 */
		}
	}
</style>
